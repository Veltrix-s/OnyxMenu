<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NocturneMenu</AssemblyName>
    <RootNamespace>Nocturne</RootNamespace>
    <TargetFramework>netcoreapp6.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>1.3.0</Version>
    <Company>Nocturne</Company>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <Private>false</Private>
    </Reference>
    <Reference Include="Hazel">
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.VideoModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityAnalyticsModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CrashReportingModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PerformanceReportingModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <PropertyGroup>
    <_NuGetBase>$(USERPROFILE)\.nuget\packages\</_NuGetBase>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(_NuGetBase)naudio\2.2.1\lib\net6.0\NAudio.dll">
      <LogicalName>Nocturne.libs.NAudio.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(_NuGetBase)naudio.core\2.2.1\lib\netstandard2.0\NAudio.Core.dll">
      <LogicalName>Nocturne.libs.NAudio.Core.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(_NuGetBase)naudio.winmm\2.2.1\lib\netstandard2.0\NAudio.WinMM.dll">
      <LogicalName>Nocturne.libs.NAudio.WinMM.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(_NuGetBase)naudio.wasapi\2.2.1\lib\netstandard2.0\NAudio.Wasapi.dll">
      <LogicalName>Nocturne.libs.NAudio.Wasapi.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(_NuGetBase)nvorbis\0.10.5\lib\netstandard2.0\NVorbis.dll">
      <LogicalName>Nocturne.libs.NVorbis.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="WinRT\**" />
    <None Remove="WinRT\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="WinRT\NocturneWinRT.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(_NuGetBase)microsoft.windows.cswinrt\2.0.8\lib\net6.0\WinRT.Runtime.dll">
      <LogicalName>Nocturne.libs.WinRT.Runtime.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="WinRT\bin\$(Configuration)\net6.0\NocturneWinRT.dll">
      <LogicalName>Nocturne.libs.NocturneWinRT.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="grid\skeld_onx.json"><LogicalName>Nocturne.grid.skeld_onx.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="grid\mira_onx.json"><LogicalName>Nocturne.grid.mira_onx.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="grid\polus_onx.json"><LogicalName>Nocturne.grid.polus_onx.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="grid\airship_onx.json"><LogicalName>Nocturne.grid.airship_onx.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="grid\fungle_onx.json"><LogicalName>Nocturne.grid.fungle_onx.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="NOCTURNE.jpg"><LogicalName>Nocturne.NOCTURNE.jpg</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="resources\*.png"><LogicalName>Nocturne.textures.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyVersionedDll" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFiles="$(OutputPath)$(AssemblyName)_v$(Version).dll" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFiles="$(MSBuildThisFileDirectory)$(AssemblyName)_v$(Version).dll" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFiles="$(MSBuildThisFileDirectory)..\$(AssemblyName)_v$(Version).dll" />
  </Target>

</Project>
