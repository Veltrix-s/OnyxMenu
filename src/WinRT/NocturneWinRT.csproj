<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NocturneWinRT</AssemblyName>
    <RootNamespace>NocturneWinRT</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>NETSDK1138;CS8981;CS0108;CS0109;CS0618;CS1591;CS0649;CS0169;CS0414;CS8500;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.0.8" ExcludeAssets="build;analyzers" />
  </ItemGroup>
</Project>